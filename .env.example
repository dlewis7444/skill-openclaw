# Copy to .env (gitignored). One path to an instance profile that lives
# outside this repo, in the deployment's own project.
# Relative paths are resolved from this skill's physical directory.
OPENCLAW_INSTANCE=/path/to/deployment/openclaw-instance.md

# More than one gateway: colon-separated, and omit OPENCLAW_INSTANCE.
# OPENCLAW_INSTANCES=/path/to/one.md:/path/to/two.md
